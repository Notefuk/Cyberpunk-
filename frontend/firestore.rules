rules_version = '2';

// Reglas de seguridad de la mesa online. v5.0.0 (plan 16 y plan 17). [Claude Code · 2026-10-24]
// La config web de Firebase es pública: estas reglas son lo único que protege los datos.
// Tests: frontend/src/sync/__tests__/rules/ (npm run test:rules, con el emulador).
//
// Modelo:
//   users/{uid}                              perfil propio
//   characters/{charId}                      ficha (ownerUid, campaignIds[0..1], schemaVersion, _w, _ts, _lastWriter)
//   characters/{charId}/ipLog/{id}           historial de IP, solo creación
//   characters/{charId}/transactions/{id}    historial de €$, solo creación
//   campaigns/{campId}                       name, gmUid, memberUids, inviteCode, createdAt
//   campaigns/{campId}/party/{charId}        resumen público de cada ficha
//   campaigns/{campId}/gm/{docId}            solo el GM
//   campaigns/{campId}/log/{entryId}         log de la mesa, solo creación
// v5.1.0 (plan 19) [Claude Code · 2026-10-27]:
//   campaigns/{campId}                       + clock {session, day, beat} y era ('2045'|'2077'), solo el GM
//   campaigns/{campId}/encounters/current    round, turnIndex, order; lo escribe el GM
//     .../combatants/{id}                    vista pública (nombre, iniciativa, estado de heridas); el dueño de un PJ toca su iniciativa
//     .../gmCombatants/{id}                  enemigo completo (HP, SP, armas), solo el GM
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function campaign(campId) {
      return get(/databases/$(database)/documents/campaigns/$(campId)).data;
    }

    function isGmOf(campId) {
      return signedIn() && campaign(campId).gmUid == uid();
    }

    function isMemberOf(campId) {
      return signedIn() && uid() in campaign(campId).memberUids;
    }

    // Una ficha está en una campaña como máximo (las reglas no pueden recorrer listas largas).
    // El dueño tiene que seguir siendo miembro: si el GM lo echa, deja de ver su ficha aunque todavía
    // diga esa campaña (plan 18). [Claude Code · 2026-10-24]
    function charCampaignGm(data) {
      return data.campaignIds.size() == 1
        && isGmOf(data.campaignIds[0])
        && data.ownerUid in campaign(data.campaignIds[0]).memberUids;
    }

    // memberNames { uid: nombre }: cada uno solo toca su propia clave al unirse o salir (plan 18).
    function onlyOwnName() {
      return request.resource.data.get('memberNames', {}).diff(resource.data.get('memberNames', {})).affectedKeys().hasOnly([uid()]);
    }

    function canEditCharacter(data) {
      return signedIn() && (data.ownerUid == uid() || charCampaignGm(data));
    }

    // Freno anti-bucle por escritor (plan 17, punto 9; decisión 6): el escritor es uid + '_' + dispositivo.
    // Cada escritura marca _w[escritor] con la hora del servidor; el mismo escritor no puede volver a
    // escribir el mismo documento antes de 1 s. Otro escritor (el GM, otro dispositivo) no se frena.
    function writerOk(before, after) {
      let w = after._lastWriter;
      return w is string
        && w.matches(uid() + '_.+')
        && after._ts == request.time
        && after._w[w] == request.time
        && after._w.diff(before == null ? {} : before._w).affectedKeys().hasOnly([w])
        && (before == null || !(w in before._w) || request.time > before._w[w] + duration.value(1, 's'));
    }

    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    match /characters/{charId} {
      // Leer un id que no existe se permite (con sesión): al subir una ficha se pregunta si el id está libre.
      // [Claude Code · 2026-10-24]
      allow read: if resource == null ? signedIn() : canEditCharacter(resource.data);

      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.campaignIds == []
        && request.resource.data.schemaVersion is int
        && writerOk(null, request.resource.data);

      allow update: if canEditCharacter(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= resource.data.schemaVersion
        && writerOk(resource.data, request.resource.data)
        && campaignChangeOk(resource.data, request.resource.data);

      allow delete: if signedIn() && resource.data.ownerUid == uid();

      // Asignar la ficha a una campaña: solo el dueño, y solo a una campaña de la que es miembro.
      // Sacarla (lista vacía) puede el dueño. El GM no cambia campaignIds.
      function campaignChangeOk(before, after) {
        return after.campaignIds == before.campaignIds
          || (before.ownerUid == uid()
              && after.campaignIds.size() <= 1
              && (after.campaignIds.size() == 0 || isMemberOf(after.campaignIds[0])));
      }

      match /{logField}/{entryId} {
        function parent() {
          return get(/databases/$(database)/documents/characters/$(charId)).data;
        }
        allow read: if (logField == 'ipLog' || logField == 'transactions') && canEditCharacter(parent());
        allow create: if (logField == 'ipLog' || logField == 'transactions')
          && canEditCharacter(parent())
          && request.resource.data._by == uid()
          && request.resource.data.id == entryId;
        allow update, delete: if false;
      }
    }

    // Reloj y era de la mesa (plan 19): si están, con forma válida. [Claude Code · 2026-10-27]
    function tableFieldsOk(d) {
      return (!('clock' in d) || (d.clock is map
          && d.clock.keys().hasOnly(['session', 'day', 'beat'])
          && d.clock.session is int && d.clock.session >= 1
          && d.clock.day is int && d.clock.day >= 1
          && d.clock.beat is int && d.clock.beat >= 1))
        && (!('era' in d) || d.era in ['2045', '2077']);
    }

    match /campaigns/{campId} {
      allow read: if signedIn() && uid() in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.gmUid == uid()
        && request.resource.data.memberUids == [uid()]
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 12;

      // El GM edita la campaña; puede pasarle el rol a otro miembro y sacar miembros, pero no a sí mismo.
      allow update: if signedIn() && resource.data.gmUid == uid()
        && request.resource.data.gmUid in request.resource.data.memberUids
        && uid() in request.resource.data.memberUids
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 12
        && tableFieldsOk(request.resource.data);

      // Unirse con el link: solo agrega su propio uid (y su nombre) y muestra el código vigente (lastJoinCode).
      allow update: if signedIn()
        && !(uid() in resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'lastJoinCode', 'memberNames'])
        && onlyOwnName()
        && request.resource.data.lastJoinCode == resource.data.inviteCode
        && request.resource.data.memberUids == resource.data.memberUids.concat([uid()]);

      // Salir: un miembro que no es el GM se saca a sí mismo.
      allow update: if signedIn()
        && uid() in resource.data.memberUids
        && resource.data.gmUid != uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberNames'])
        && onlyOwnName()
        && request.resource.data.memberUids == resource.data.memberUids.removeAll([uid()]);

      allow delete: if signedIn() && resource.data.gmUid == uid();

      match /party/{charId} {
        allow read: if isMemberOf(campId);
        // Lo escribe la capa de sync del dueño de la ficha (o el GM).
        allow create, update: if isMemberOf(campId)
          && (request.resource.data.ownerUid == uid() || isGmOf(campId))
          && (resource == null || resource.data.ownerUid == request.resource.data.ownerUid);
        allow delete: if isGmOf(campId) || (signedIn() && resource.data.ownerUid == uid());
      }

      match /gm/{docId} {
        // v5.3.0 (plan 20, B.1): notas, NPCs propios y arquitecturas NET; forma, tamaño y 1 escritura/s. [Claude Code · 2026-10-28]
        allow read, delete: if isGmOf(campId);
        allow create, update: if isGmOf(campId)
          && docId in ['notes', 'npcs', 'net']
          && request.resource.data._ts == request.time
          && (resource == null || request.time > resource.data._ts + duration.value(1, 's'))
          && (docId != 'notes' || (request.resource.data.keys().hasOnly(['text', '_ts'])
              && request.resource.data.text is string && request.resource.data.text.size() <= 100000))
          && (docId != 'npcs' || (request.resource.data.keys().hasOnly(['items', '_ts'])
              && request.resource.data.items is list && request.resource.data.items.size() <= 200))
          && (docId != 'net' || (request.resource.data.keys().hasOnly(['items', '_ts'])
              && request.resource.data.items is list && request.resource.data.items.size() <= 50));
      }

      // Log de la mesa (plan 19, punto 4): tiradas cortas, con su propio id, a nombre de quien las crea. [Claude Code · 2026-10-27]
      match /log/{entryId} {
        allow read: if isMemberOf(campId);
        allow create: if isMemberOf(campId)
          && request.resource.data._by == uid()
          && request.resource.data.id == entryId
          && request.resource.data.keys().hasOnly(['id', '_by', 'at', 'charId', 'handle', 'kind', 'label', 'detail', 'total'])
          && request.resource.data.at == request.time
          && (request.resource.data.kind in ['attack', 'damage', 'skill', 'initiative', 'deathSave']
              // v5.2.0 (plan 20): acciones del GM sobre un PJ; solo las publica el GM. [Claude Code · 2026-10-28]
              || (request.resource.data.kind == 'gm' && isGmOf(campId)))
          && request.resource.data.handle is string && request.resource.data.handle.size() <= 60
          && request.resource.data.label is string && request.resource.data.label.size() <= 120
          && (!('detail' in request.resource.data) || (request.resource.data.detail is string && request.resource.data.detail.size() <= 300))
          && (!('total' in request.resource.data) || request.resource.data.total is number);
        allow update: if false;
        allow delete: if isGmOf(campId);
      }

      // v5.3.0 (plan 20, B.2): lo que el GM revela a la mesa. Handouts (solo creación) y la corrida NET. [Claude Code · 2026-10-28]
      match /reveals/{rid} {
        allow read: if isMemberOf(campId);
        allow delete: if isGmOf(campId);
        allow create, update: if isGmOf(campId) && rid == 'net'
          && request.resource.data.keys().hasOnly(['archName', 'totalFloors', 'currentFloor', 'floors', 'forCharId', '_ts'])
          && request.resource.data.archName is string && request.resource.data.archName.size() <= 120
          && request.resource.data.floors is list && request.resource.data.floors.size() <= 30
          && request.resource.data._ts == request.time;
        allow create: if isGmOf(campId) && rid != 'net'
          && request.resource.data.keys().hasOnly(['id', 'kind', 'title', 'text', 'at', '_by'])
          && request.resource.data.id == rid
          && request.resource.data.kind == 'note'
          && request.resource.data._by == uid()
          && request.resource.data.at == request.time
          && request.resource.data.title is string && request.resource.data.title.size() <= 80
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
      }

      // Encuentro compartido (plan 19, punto 3). [Claude Code · 2026-10-27]
      match /encounters/{encId} {
        allow read: if isMemberOf(campId);
        allow write: if isGmOf(campId);

        match /combatants/{cid} {
          allow read: if isMemberOf(campId);
          allow delete: if isGmOf(campId);
          allow create, update: if isGmOf(campId);
          // El jugador se suma con su propio PJ (id 'pc-' + charId de una ficha suya) y después solo cambia su iniciativa.
          allow create: if isMemberOf(campId)
            && request.resource.data.kind == 'pc'
            && request.resource.data.ownerUid == uid()
            && cid == 'pc-' + request.resource.data.charId
            && get(/databases/$(database)/documents/characters/$(request.resource.data.charId)).data.ownerUid == uid()
            && request.resource.data.keys().hasOnly(['kind', 'name', 'initiative', 'charId', 'ownerUid', 'woundState']);
          allow update: if isMemberOf(campId)
            && resource.data.kind == 'pc'
            && resource.data.ownerUid == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['initiative', 'woundState']);
        }

        match /gmCombatants/{cid} {
          allow read, write: if isGmOf(campId);
        }
      }
    }
  }
}
